# Local development configuration
AI_PROVIDER=mock
DATABASE_URL=postgresql://bodega:bodega_local@postgres:5432/bodega
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=sales-images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_local_password
APP_ACCESS_CODE=replace-with-a-local-development-code
OWNER_ID=00000000-0000-4000-8000-000000000001
OWNER_DISPLAY_NAME=Local Owner
APP_TIMEZONE=America/Santo_Domingo
# Extraction (José): AI_PROVIDER=claude with a real key reads photos/text; mock needs no key.
AI_API_KEY=replace-with-an-anthropic-api-key
AI_EXTRACTION_MODEL=claude-sonnet-5-5
# Browser-reachable endpoint used only for signed image-preview URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Guidance wording model for AI_PROVIDER=claude (ClaudeLLMService). Without a key: "Standard advice" template.
AI_GUIDANCE_MODEL=claude-haiku-5-5
# Only origin allowed by CORS. Locally the SPA is same-origin through the Vite proxy.
FRONTEND_URL=http://localhost:5173
# Frontend container only: backend URL written to /config.js at start. Empty = same origin.
API_BASE_URL=
# Reverse proxies in front of the backend that append to X-Forwarded-For (Render: 1, local: 0).
# The access-code rate limit counts the address the outermost one appended (app/security.py).
TRUSTED_PROXY_HOPS=0
